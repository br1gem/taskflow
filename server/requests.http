@baseUrl = http://localhost:3000
@taskId = 11111111-1111-4111-8111-111111111111

### Проверить сервер
GET {{baseUrl}}/api/health

### Получить все задачи
GET {{baseUrl}}/api/tasks

### Получить задачи со статусом «Готово»
GET {{baseUrl}}/api/tasks?status=%D0%93%D0%BE%D1%82%D0%BE%D0%B2%D0%BE

### Получить одну задачу
GET {{baseUrl}}/api/tasks/{{taskId}}

### Создать задачу
POST {{baseUrl}}/api/tasks
Content-Type: application/json

{
  "title": "Подготовить третью практику",
  "project": "TaskFlow",
  "status": "Нужно сделать",
  "priority": "Высокий",
  "dueDate": "2026-09-30"
}

### Проверить ошибку 400 при пустом названии
POST {{baseUrl}}/api/tasks
Content-Type: application/json

{
  "title": "",
  "project": "TaskFlow",
  "status": "В работе",
  "priority": "Средний"
}

### Проверить ошибку 400 при недопустимом статусе
POST {{baseUrl}}/api/tasks
Content-Type: application/json

{
  "title": "Проверить валидацию",
  "project": "TaskFlow",
  "status": "Срочно",
  "priority": "Средний"
}

### Изменить статус задачи
PATCH {{baseUrl}}/api/tasks/{{taskId}}
Content-Type: application/json

{
  "status": "Готово"
}

### Изменить название и приоритет
PATCH {{baseUrl}}/api/tasks/{{taskId}}
Content-Type: application/json

{
  "title": "Подготовить макет интерфейса",
  "priority": "Средний"
}

### Удалить задачу
DELETE {{baseUrl}}/api/tasks/{{taskId}}

### Проверить ошибку 404 для неизвестной задачи
GET {{baseUrl}}/api/tasks/00000000-0000-4000-8000-000000000000

### Проверить ошибку 404 для неизвестного маршрута
GET {{baseUrl}}/api/unknown